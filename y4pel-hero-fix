/*
  Y4PEL HERO FIX — load this file AFTER your existing style.css.
  It only adjusts the hero and does not remove or restyle the rest of the website.
*/

/* Keep the hero independent from the old site's global section spacing. */
.hero {
  box-sizing: border-box;
  position: relative;
  isolation: isolate;
  overflow: hidden;
  width: 100%;
  min-height: min(760px, 100svh);
  margin-top: 0 !important;
  padding: 72px clamp(22px, 7vw, 118px) 76px !important;
  display: grid;
  grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
  align-items: center;
  gap: clamp(20px, 3vw, 48px);
  color: #fff;
  background:
    radial-gradient(ellipse at 76% 48%, rgba(24, 139, 92, .34), transparent 38%),
    radial-gradient(ellipse at 8% 0%, rgba(32, 140, 96, .22), transparent 38%),
    linear-gradient(118deg, #063a2c 0%, #07513a 52%, #063a2c 100%);
}

.hero,
.hero * {
  box-sizing: border-box;
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: .2;
  background-image: radial-gradient(rgba(207, 255, 229, .65) .7px, transparent .7px);
  background-size: 28px 28px;
  mask-image: linear-gradient(90deg, transparent, #000 70%);
}

.hero-copy {
  position: relative;
  z-index: 2;
  min-width: 0;
  max-width: 590px;
  padding: 0;
}

.hero .eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 24px;
  color: #b8f0d2;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  line-height: 1.5;
  text-transform: uppercase;
}

.eyebrow-dot,
.label-pulse {
  flex: 0 0 auto;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #74e3a6;
  box-shadow: 0 0 0 5px rgba(116, 227, 166, .12);
}

.hero h1 {
  margin: 0;
  color: #fff;
  font-family: Manrope, Poppins, sans-serif;
  font-size: clamp(44px, 5.4vw, 78px);
  font-weight: 800;
  line-height: 1.02;
  letter-spacing: -.045em;
  overflow-wrap: anywhere;
}

.hero h1 span {
  color: #9be5bc;
}

.hero .hero-description {
  max-width: 465px;
  margin: 26px 0 28px;
  color: rgba(255, 255, 255, .8);
  font-size: 16px;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px 24px;
}

.hero .button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  min-height: 48px;
  padding: 14px 20px;
  border: 1px solid transparent;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.3;
  text-decoration: none;
  transition: transform .2s ease, background-color .2s ease, color .2s ease;
}

.hero .button:hover {
  transform: translateY(-2px);
}

.hero .button-primary {
  background: #b8f0d2;
  color: #073d2c;
}

.hero .button-primary:hover {
  background: #d1f8e2;
}

.hero .text-link {
  color: rgba(255, 255, 255, .92);
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
}

.hero .text-link span {
  padding-left: 7px;
  color: #9be5bc;
}

.hero-proof {
  display: flex;
  align-items: center;
  gap: 13px;
  max-width: 400px;
  margin-top: 42px;
  padding-top: 20px;
  border-top: 1px solid rgba(184, 240, 210, .22);
}

.proof-icon {
  display: grid;
  flex: 0 0 37px;
  width: 37px;
  height: 37px;
  place-items: center;
  border: 1px solid rgba(184, 240, 210, .55);
  border-radius: 50%;
  color: #b8f0d2;
  font-size: 22px;
}

.hero-proof strong,
.hero-proof small {
  display: block;
}

.hero-proof strong {
  margin-bottom: 5px;
  color: #fff;
  font-size: 12px;
}

.hero-proof small {
  color: rgba(255, 255, 255, .65);
  font-size: 11px;
  line-height: 1.5;
}

.hero-visual {
  position: relative;
  isolation: isolate;
  min-width: 0;
  width: 100%;
  height: min(590px, 70vw);
  min-height: 420px;
}

#globeViz {
  position: absolute;
  z-index: 2;
  inset: 0;
  width: 100%;
  height: 100%;
  cursor: grab;
}

#globeViz:active {
  cursor: grabbing;
}

#globeViz canvas {
  display: block;
  width: 100% !important;
  height: 100% !important;
  outline: none;
}

.map-fallback {
  display: grid;
  width: 100%;
  height: 100%;
  place-items: center;
  padding: 24px;
  color: #b8f0d2;
  text-align: center;
}

.visual-orbit {
  position: absolute;
  z-index: 1;
  border: 1px solid rgba(159, 240, 193, .14);
  border-radius: 50%;
  pointer-events: none;
}

.orbit-one {
  top: 17%;
  left: 3%;
  width: 92%;
  height: 61%;
  transform: rotate(-22deg);
}

.orbit-two {
  top: 9%;
  left: -5%;
  width: 110%;
  height: 76%;
  transform: rotate(24deg);
  border-color: rgba(159, 240, 193, .08);
}

.globe-label {
  position: absolute;
  z-index: 4;
  top: 23px;
  right: 2%;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #b8f0d2;
  font-size: 10px;
  letter-spacing: 1.7px;
}

.globe-label .label-pulse {
  width: 6px;
  height: 6px;
}

.globe-hint {
  position: absolute;
  z-index: 4;
  bottom: 52px;
  left: 50%;
  color: rgba(255, 255, 255, .68);
  font-size: 9px;
  letter-spacing: 1.5px;
  text-align: center;
  white-space: nowrap;
  pointer-events: none;
  transform: translateX(-50%);
}

.drag-icon {
  margin-right: 8px;
  color: #9be5bc;
  font-size: 18px;
  vertical-align: -2px;
}

.country-card {
  position: absolute;
  z-index: 5;
  bottom: 85px;
  left: 0;
  width: min(205px, 45%);
  padding: 17px 18px;
  border: 1px solid rgba(184, 240, 210, .25);
  border-radius: 9px;
  background: rgba(4, 52, 38, .82);
  box-shadow: 0 15px 40px rgba(0, 0, 0, .13);
  backdrop-filter: blur(12px);
}

.card-kicker {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 10px;
  color: #9be5bc;
  font-size: 8px;
  letter-spacing: 1.4px;
}

.card-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #73e5a7;
}

.country-card strong {
  display: block;
  margin-bottom: 6px;
  color: #fff;
  font: 700 17px Manrope, Poppins, sans-serif;
}

.country-card > span:last-child {
  display: block;
  color: rgba(255, 255, 255, .72);
  font-size: 11px;
  line-height: 1.55;
}

.globe-counter {
  position: absolute;
  z-index: 4;
  right: 0;
  bottom: 105px;
  display: flex;
  align-items: center;
  gap: 11px;
}

.globe-counter strong {
  color: #b8f0d2;
  font: 800 43px Manrope, Poppins, sans-serif;
  letter-spacing: -2px;
}

.globe-counter span {
  color: rgba(255, 255, 255, .78);
  font-size: 10px;
  line-height: 1.45;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.visual-caption {
  position: absolute;
  z-index: 4;
  right: 0;
  bottom: 16px;
  color: rgba(255, 255, 255, .48);
  font-size: 9px;
  letter-spacing: 2px;
}

.hero-bottom-line {
  position: absolute;
  z-index: 3;
  right: clamp(22px, 7vw, 118px);
  bottom: 0;
  left: clamp(22px, 7vw, 118px);
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 17px 0;
  border-top: 1px solid rgba(184, 240, 210, .2);
  color: rgba(255, 255, 255, .55);
  font-size: 9px;
  letter-spacing: 1.5px;
}

/* Tablet */
@media (max-width: 1050px) {
  .hero {
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    padding-right: 36px !important;
    padding-left: 36px !important;
  }

  .hero h1 {
    font-size: clamp(42px, 5.2vw, 62px);
    letter-spacing: -.04em;
  }

  .hero-visual {
    height: 510px;
    min-height: 390px;
  }

  .country-card {
    width: 175px;
  }
}

/* Mobile */
@media (max-width: 780px) {
  .hero {
    min-height: 0;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    padding: 54px 24px 76px !important;
  }

  .hero-copy {
    max-width: 650px;
  }

  .hero .eyebrow {
    margin-bottom: 20px;
    font-size: 9px;
    letter-spacing: 1.5px;
  }

  .hero h1 {
    font-size: clamp(43px, 11vw, 68px);
    line-height: 1.03;
    letter-spacing: -.04em;
  }

  .hero .hero-description {
    margin: 21px 0 23px;
    font-size: 15px;
  }

  .hero-proof {
    margin-top: 28px;
  }

  .hero-visual {
    height: min(110vw, 490px);
    min-height: 350px;
    margin: 0;
  }

  .globe-label {
    top: 12px;
    right: 1%;
    font-size: 8px;
  }

  .country-card {
    bottom: 48px;
    width: min(165px, 44%);
    padding: 13px;
  }

  .country-card strong {
    font-size: 14px;
  }

  .globe-counter {
    bottom: 55px;
    gap: 7px;
  }

  .globe-counter strong {
    font-size: 34px;
  }

  .globe-counter span {
    font-size: 8px;
  }

  .globe-hint {
    bottom: 17px;
    font-size: 8px;
    letter-spacing: 1px;
  }

  .visual-caption {
    display: none;
  }

  .hero-bottom-line {
    right: 24px;
    left: 24px;
    font-size: 7px;
    letter-spacing: 1px;
  }
}

@media (max-width: 420px) {
  .hero {
    padding-right: 20px !important;
    padding-left: 20px !important;
  }

  .hero-actions {
    gap: 14px;
  }

  .hero .button {
    padding: 13px 14px;
  }

  .hero-visual {
    height: 390px;
    min-height: 330px;
    margin-inline: -8px;
    width: calc(100% + 16px);
  }

  .country-card {
    bottom: 42px;
    width: 142px;
  }

  .globe-counter {
    bottom: 48px;
  }

  .globe-counter strong {
    font-size: 28px;
  }

  .hero-bottom-line {
    flex-wrap: wrap;
    font-size: 6px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero,
  .hero * {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
  }
}
